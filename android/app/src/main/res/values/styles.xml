<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#365A24</item>
        <item name="android:colorControlActivated">#365A24</item>
        <item name="android:colorControlHighlight">#33B8EF73</item>
        <item name="android:textColorPrimary">#191D1A</item>
        <item name="android:textColorSecondary">#616A63</item>
        <item name="android:textColorHint">#687168</item>
        <item name="android:colorBackground">#F7F7F2</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F7F2</item>
        <item name="android:navigationBarColor">#F7F7F2</item>
        <item name="android:windowBackground">#F7F7F2</item>
        <item name="android:alertDialogTheme">@style/DialogTheme</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#B8EF73</item>
        <item name="android:colorControlActivated">#B8EF73</item>
        <item name="android:colorControlHighlight">#33B8EF73</item>
        <item name="android:textColorPrimary">#F4F5EF</item>
        <item name="android:textColorSecondary">#BEC6BD</item>
        <item name="android:textColorHint">#A8B3A7</item>
        <item name="android:colorBackground">#111512</item>
        <item name="android:colorBackgroundFloating">#202521</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#111512</item>
        <item name="android:navigationBarColor">#111512</item>
        <item name="android:windowBackground">#111512</item>
        <item name="android:alertDialogTheme">@style/DialogThemeDark</item>
    </style>
    <style name="DialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#365A24</item>
        <item name="android:textColorPrimary">#191D1A</item>
        <item name="android:textColorSecondary">#616A63</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
    </style>
    <style name="DialogThemeDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#B8EF73</item>
        <item name="android:textColorPrimary">#F4F5EF</item>
        <item name="android:textColorSecondary">#BEC6BD</item>
        <item name="android:colorBackgroundFloating">#202521</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
    </style>
    <style name="DialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="ShareTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="ShareThemeDark" parent="AppThemeDark">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
